// DET001: small password set attempted across multiple cloud accounts.
// Native Entra table version. For ASIM, map equivalent fields from _Im_Authentication.
let DetectionId = "DET001";
let Lookback = 30m;
let Bucket = 10m;
let MinimumUsers = 4;
let MinimumFailures = 5;
let CorporateEgress = dynamic(["198.51.100.20"]); // Replace from a governed watchlist.
let ServiceAccounts = dynamic(["legacy-sync@northbridge.example"]); // Replace from a governed watchlist.
SigninLogs
| where TimeGenerated > ago(Lookback)
| where ResultType != 0 and IPAddress !in (CorporateEgress)
| where UserPrincipalName !in~ (ServiceAccounts)
| summarize FailureCount=count(), AccountCount=dcount(UserPrincipalName),
    Users=make_set(UserPrincipalName, 50), FirstSeen=min(TimeGenerated), LastSeen=max(TimeGenerated)
    by IPAddress, bin(TimeGenerated, Bucket)
| where FailureCount >= MinimumFailures and AccountCount >= MinimumUsers
// Emit one deterministic entity row per targeted account so fusion can match any target.
| extend Users=array_sort_asc(Users)
| mv-expand User=Users to typeof(string)
| extend Timestamp=LastSeen,
    Evidence=strcat(FailureCount, " failures across ", AccountCount, " accounts")
| project DetectionId, Timestamp, User, IPAddress, FailureCount, AccountCount, Users, FirstSeen, LastSeen, Evidence
